@page
@model Kool_Ref_Inventory_System.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Sign in to the Kool Refrigeration inventory portal." />
    <title>Sign in | Kool Ref Inventory</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page login-page-simple">
    <main class="login-shell login-shell-simple">
        <section class="login-card login-card-simple" aria-labelledby="login-title">
            <div class="login-simple-header">
                <img src="~/css/logo_KoolRefrigerationEnterprisesInc2.png"
                     alt="Kool Refrigeration Enterprises Inc." />
                <span>Inventory operations portal</span>
            </div>

            <div class="login-form-panel login-form-panel-simple">
                <div class="login-form-heading">
                    <p class="section-kicker">Welcome back</p>
                    <h1 id="login-title">Sign in</h1>
                    <p>Enter your account details to continue.</p>
                </div>

                <form method="post" asp-page="/Login" class="login-form">
                    <div asp-validation-summary="ModelOnly" class="login-error" role="alert"></div>

                    <div class="login-field">
                        <label asp-for="Username">Username</label>
                        <div class="login-input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" /></svg>
                            <input asp-for="Username" type="text" autocomplete="username"
                                   placeholder="Enter your username" autofocus required />
                        </div>
                    </div>

                    <div class="login-field">
                        <label asp-for="Password">Password</label>
                        <div class="login-input-wrap">
                            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6 10V8a6 6 0 0 1 12 0v2M5 10h14v11H5V10Zm7 5v2" /></svg>
                            <input asp-for="Password" type="password" autocomplete="current-password"
                                   placeholder="Enter your password" required />
                        </div>
                    </div>

                    <button class="button button-primary login-submit" type="submit">Sign in</button>
                </form>

                <p class="login-access-warning" role="note">
                    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 3 5 6v5c0 4.6 2.9 8.1 7 10 4.1-1.9 7-5.4 7-10V6l-7-3Zm0 5v5m0 3v.01" /></svg>
                    <span><strong>Warning:</strong> Unauthorized access is prohibited.</span>
                </p>
            </div>
        </section>

        <footer class="login-footer">
            &copy; @DateTime.Now.Year Kool Refrigeration Enterprises Inc.
        </footer>
    </main>
</body>
</html>
